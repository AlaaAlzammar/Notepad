<Window x:Class="Notepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:Notepad"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <DockPanel Margin="16">

 
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Mini Notepad Editor" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="CurrentFileText" Text="Current File: Untitled"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

      
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}">
            <StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NewButton" Style="{StaticResource ToolbarButtonBase}" Click="NewButton_Click" ToolTip="Create a new document">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="file" Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="New"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenButton" Style="{StaticResource ToolbarButtonBase}" Click="OpenButton_Click" ToolTip="Open a text file">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="file" Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveButton" Style="{StaticResource ToolbarButtonBase}" Click="SaveButton_Click" ToolTip="Save the current file">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="FolderOpen" Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveAsButton" Style="{StaticResource ToolbarButtonBase}" Click="SaveAsButton_Click" ToolTip="Save the file under a new name">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Save" Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ClearButton" Style="{StaticResource DangerButton}" Click="ClearButton_Click" ToolTip="Clear all text">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Copy" Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Clear"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DateTimeButton" Style="{StaticResource ToolbarButtonBase}" Click="DateTimeButton_Click" ToolTip="Insert current date and time">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome  Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Insert Date/Time"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

           
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Font Family:" Style="{StaticResource OptionLabelStyle}"/>
                    <ComboBox x:Name="FontFamilyComboBox" Style="{StaticResource OptionComboBoxStyle}"
                              SelectionChanged="FontFamilyComboBox_SelectionChanged"/>

                    <TextBlock Text="Font Size:" Style="{StaticResource OptionLabelStyle}"/>
                    <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="48" Value="16"
                            Width="180" VerticalAlignment="Center" Margin="0,0,8,0"
                            TickFrequency="2" IsSnapToTickEnabled="True"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                    <TextBlock x:Name="FontSizeValueText" Text="16" VerticalAlignment="Center" Margin="0,0,20,0" Width="24"/>

                    <CheckBox x:Name="WrapTextCheckBox" Content="Wrap Text" IsChecked="True"
                              Style="{StaticResource OptionCheckBoxStyle}"
                              Checked="WrapTextCheckBox_Changed" Unchecked="WrapTextCheckBox_Changed"/>

                    <CheckBox x:Name="ReadOnlyCheckBox" Content="Read Only"
                              Style="{StaticResource OptionCheckBoxStyle}"
                              Checked="ReadOnlyCheckBox_Changed" Unchecked="ReadOnlyCheckBox_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>


        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="14,8">
            <Grid>
                <TextBlock x:Name="LeftStatusText" Text="0 characters | 0 words | 1 line(s)"
                           HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="RightStatusText" Text="Ln 1, Col 1"
                           HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

   
        <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0">
            <TextBox x:Name="MainTextBox"
                     Style="{StaticResource EditorTextBoxStyle}"
                     FontFamily="Segoe UI" FontSize="16"
                     TextWrapping="Wrap"
                     TextChanged="MainTextBox_TextChanged"
                     SelectionChanged="MainTextBox_SelectionChanged"/>
        </Border>

    </DockPanel>
</Window>
